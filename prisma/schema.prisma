generator client {
  provider = \"prisma-client-js\"
}

datasource db {
  provider = \"postgresql\"
  url      = env(\"DATABASE_URL\")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String?  @unique
  createdAt DateTime @default(now())
}

model Lead {
  id     String @id @default(uuid())
  status String?
}

model Site {
  id      String @id @default(uuid())
  address String?
}

model Job {
  id        String @id @default(uuid())
  leadId    String?
  siteId    String?
  status    String? @default("pending")
  createdAt DateTime @default(now())
}

model Invoice {
  id     String @id @default(uuid())
  jobId  String?
  amount Float?
  status String?
}
